{% for block in asideTextBlocks %}
  <section class="aside__block">
    <details class="aside__block-details">
      <summary class="aside__block-summary">
      <div class="aside__block-summary-wrapper">
          <h3 class="aside__block-title">{{ block.title }}</h3>
          <div>
          <svg class="aside__summary-icon" width="16" height="16">
            <use href="/img/sprite.svg#{{ block.iconClosed }}"></use>
          </svg>
          <svg class="aside__summary-icon-open" width="16" height="16">
            <use href="/img/sprite.svg#{{ block.iconOpen }}"></use>
          </svg>
          </div>
        </div>
      </summary>
      <div class="aside__block-item">
        <p class="aside__block-detalis">{{ block.text }}</p>
      </div>
    </details>
  </section>
{% endfor %}