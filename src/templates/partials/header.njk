<header class="header container">
  <div class="header__menu-wrapper">
    <div class="header__burger-wrapper">
      <div class="header__burger-btn">
        <svg class="header__burger-img" width="18" height="12" aria-label="{{ header.burgerAlt }}">
          <use href="/img/sprite.svg#{{ header.burgerIcon }}"></use>
        </svg>
      </div>
    </div>
    <div class="header-logo">
      <a class="header-logo__link" href="{{ header.logolink }}">
        <svg class="header-logo__image" width="36" height="40" aria-label="{{ header.logoAltSmall }}">
          <use href="/img/sprite.svg#{{ header.logoImgSmall }}"></use>
        </svg>
      </a>
    </div>
    <div class="header-logo__alt">
      <a class="header-logo__link" href="{{ header.logolink }}">
        <svg class="header-logo__image" width="188" height="42" aria-label="{{ header.logoAltWhite }}">
          <use href="/img/sprite.svg#{{ header.logoImgWhite }}"></use>
        </svg>
      </a>
    </div>
  </div>
  <div class="header-section">
    {% include "partials/header-search.njk" %}
    <nav class="main-nav">
      <ul class="main-nav-list">
        {% for item in header.nav %}
          <li class="main-nav-list__item">
            <a class="main-nav-list__list-link{% if item.text == currentPage %} main-nav-list__list-link--active{% endif %}" href="{{ item.link }}">{{ item.text }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
  <div class="header-actions">{% include "partials/header-buttons.njk" %}</div>
</header>