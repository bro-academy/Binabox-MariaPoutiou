<button class="button header__button-secondary button--secondary">
  <svg class="header-button__img" width="22" height="16" aria-label="{{ headerButtons.altSecondary }}">
    <use href="/img/sprite.svg#{{ headerButtons.imgSecondary }}"></use>
  </svg>
  {{ headerButtons.textSecondary }}
</button>
<button class="button header__button-primary button--primary">
  <svg class="header-button__img" width="20" height="20" aria-label="{{ headerButtons.altPrimary }}">
    <use href="/img/sprite.svg#{{ headerButtons.imgPrimary }}"></use>
  </svg>
  {{ headerButtons.textPrimary }}
</button>