<button class="button button--secondary catalog__button">
  {{ catalogButtons.all }}
</button>
<div class="catalog__pagination">
  <button class="button button--secondary catalog__button--prev">
          <svg class="catalog__button-prev-img" width="24" height="24" aria-label="{{ catalogButtons.prevAlt }}">
        <use href="/img/sprite.svg#{{ catalogButtons.prevImg }}"></use>
      </svg>
  </button>
  <button class="button button--primary catalog__button--next">
              <svg class="catalog__button-next-img" width="24" height="24" aria-label="{{ catalogButtons.prevNext }}">
        <use href="/img/sprite.svg#{{ catalogButtons.nextImg }}"></use>
      </svg>
  </button>
</div>
