<button class="button button--secondary catalog__button">
  {{ catalogButtons.all }}
</button>
<div class="catalog__pagination">
  <button class="button button--secondary catalog__button--prev">
          <svg class="catalog__button--prev-img" width="24" height="24" aria-label="{{ catalogSection.imgAlt }}">
        <use href="/img/sprite.svg#arrow-left"></use>
      </svg>
  </button>
  <button class="button button--primary catalog__button--next">
              <svg class="catalog__button--prev-img" width="24" height="24" aria-label="{{ catalogSection.imgAlt }}">
        <use href="/img/sprite.svg#arrow-right"></use>
      </svg>
  </button>
</div>
